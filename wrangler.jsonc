{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diggo-fun",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/webhooks/*", "/ARCHITECTURE.md"]
  },
  "routes": [
    {
      "pattern": "diggo.fun",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SOLANA_CLUSTER": "devnet",
    "POSTHOG_API_KEY": "phc_rUmzX7ft4ue8iLqACMEe8NgaJphvWYVD9WtwRGfC6nQK",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "SUPABASE_URL": "https://mtkvvcybpasehmscueox.supabase.co",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEzwvf6nnwXvXdMc",
    "DIGGO_PROGRAM_ID": "48WgfSPnEPitiasXV5B3aLpeAWtUisSt6YSR6djDZebC",
    "DIGGO_TREASURY": "3YwWHow5jFCtE3vQGadPiLi83eNRwDaEmCZebuEx71PQ",
    "DIGGO_KEEPER": "G3QELLuGprfRBYxoh3P5v4ZkGFyNXGLjATsNYZx6xWu8",
    "VANITY_SUFFIX": "diggo"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diggo-db",
      "database_id": "b985e043-b65e-4103-8f72-d4c98d47d1cf",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TOKEN_CACHE",
      "id": "d40b446e286b4c3fa6141e9eeaf983e1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKETS",
        "class_name": "TokenMarket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TokenMarket"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INDEXING_QUEUE",
        "queue": "diggo-indexing"
      }
    ],
    "consumers": [
      {
        "queue": "diggo-indexing",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "diggo-indexing-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
