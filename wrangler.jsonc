{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diggo-fun",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  // Lets Worker code distinguish Wrangler's local runtime from a deployed version. Local Wrangler
  // supplies an empty tag; deployed versions carry real version metadata.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/webhooks/*", "/ARCHITECTURE.md"]
  },
  "routes": [
    {
      "pattern": "diggo.fun",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SOLANA_CLUSTER": "mainnet-beta",
    "CHAIN_MODE": "meteora",
    "METEORA_DBC_CONFIG": "SET_AFTER_CREATE",
    "MINING_VAULT_PUBLIC_KEY": "H5TTpszeSNneNNxypM3UjaWMjVRNTvmWSCXfgTtzdELT",
    "MINING_CLAIM_PER_CLAIM": "250000000",
    "MINING_CLAIM_PER_DAY": "1000000000",
    "MINING_VAULT_SWEEP_LIMIT": "50",
    // DIGGO_RPC_URL is a deployed Worker secret and must be a mainnet endpoint. The public
    // fallbacks below are only a last-resort availability path; browser RPC always uses /api/rpc.
    "DIGGO_RPC_URLS": "https://api.mainnet-beta.solana.com",
    "POSTHOG_API_KEY": "phc_rUmzX7ft4ue8iLqACMEe8NgaJphvWYVD9WtwRGfC6nQK",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "SUPABASE_URL": "https://mtkvvcybpasehmscueox.supabase.co",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEzwvf6nnwXvXdMc",
    "DIGGO_TREASURY": "6HHEkX5MxsoQwyCJZHvLnewmnsaw19vGT9Y8jhqH7GuJ",
    "VANITY_SUFFIX": "diggo",
    // The optional crank bot (worker/crank.ts). It holds no authority: every instruction it sends
    // is permissionless, and the only thing its key does is pay the fee. The key itself belongs in
    // `wrangler secret put DIGGO_CRANK_SECRET_KEY`; `CRANK_ENABLED` is the kill switch, and "0"
    // turns the bot off without removing the secret.
    "CRANK_ENABLED": "1",
    // Indexer tuning. Bounded so one cron pass cannot run past its budget on a busy program.
    // The per-pass limits preserve the previous per-minute throughput on a five-minute cadence.
    "INDEXER_SIGNATURE_LIMIT": "500",
    "INDEXER_MAX_PAGES": "3",
    "INDEXER_COIN_LIMIT": "1000",
    // Price oracle (worker/oracle.ts, docs/SECURITY.md "Price oracle"). Every one of these has a
    // working default - the public Jupiter and Pyth endpoints and the published SOL/USD feed id -
    // so they are listed rather than set: an empty string is not an override, it just falls back.
    // API keys belong in `wrangler secret put JUPITER_API_KEY` / `PYTH_API_KEY`, never here.
    //JUPITER_PRICE_URL: "",
    //JUPITER_PRICE_V2_URL: "",
    //PYTH_HERMES_URL: "",
    //PYTH_SOL_USD_FEED_ID: "",
    //ORACLE_MIN_EXTERNAL_SOURCES: "0",
    //ORACLE_SOL_USD_OVERRIDE: ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diggo-db",
      "database_id": "b985e043-b65e-4103-8f72-d4c98d47d1cf",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TOKEN_CACHE",
      "id": "d40b446e286b4c3fa6141e9eeaf983e1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKETS",
        "class_name": "TokenMarket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TokenMarket"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PlayerLock"]
    },
    {
      // The v4 per-wallet mutation mutex, retired. v2 has no server-side mutation to serialise:
      // every mutation is a signed transaction the player sends, so the lock and its binding are
      // gone. The class is removed by its own migration rather than by editing v2's, so a
      // deployment that already applied v2 still converges.
      "tag": "v3",
      "deleted_classes": ["PlayerLock"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INDEXING_QUEUE",
        "queue": "diggo-indexing"
      }
    ],
    "consumers": [
      {
        "queue": "diggo-indexing",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "diggo-indexing-dlq"
      }
    ]
  },
  "triggers": {
    // Indexing runs on a short cadence because the index is what the read API serves; the
    // advisory sweeps (social, risk, crank) ride along on the same tick and are all idempotent.
    "crons": ["*/5 * * * *"]
  },
  // Analytics Engine is deliberately NOT bound: the Cloudflare account this Worker deploys to
  // has Analytics Engine disabled, and a deploy that declares an analytics_engine_datasets
  // binding is rejected outright with error 10089 ("Analytics Engine is not enabled for this
  // account"). worker/telemetry.ts reads the dataset through metricsDatasetBinding() and no-ops
  // when it is absent, so every counter still lands in the authoritative D1 metrics_counters
  // table - only the SQL-mirror for dashboards is missing. docs/DEPLOYMENT.md, "Observability
  // and alerts", documents how to turn the mirror back on.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 500,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    // Staging mirrors production bindings but every resource name, dataset and rate-limit
    // namespace is its own. Anything marked TODO(staging) still points at a placeholder id and
    // must be replaced with the real id created by `wrangler d1 create` / `wrangler kv namespace
    // create` before the first `npm run deploy:staging`.
    //
    // Named environments do not inherit bindings, vars, assets, routes, Durable Objects, queues,
    // rate limits or Analytics Engine datasets from the top level, so each block is repeated here
    // on purpose. Staging deliberately declares no custom-domain route: it stays on workers.dev.
    "staging": {
      "name": "diggo-fun-staging",
      "compatibility_date": "2026-09-13",
      "compatibility_flags": ["nodejs_compat"],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      // Routes are one of the few fields a named environment DOES inherit, so this has to be
      // cleared explicitly: without it a staging deploy would move the diggo.fun custom domain
      // off the production Worker. Staging therefore stays on its workers.dev hostname.
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/media/*", "/webhooks/*", "/ARCHITECTURE.md"]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        // Devnet only. Staging must never point at a mainnet program id or RPC.
        "SOLANA_CLUSTER": "devnet",
        "CHAIN_MODE": "meteora",
        "METEORA_DBC_CONFIG": "5Dtu9MNLM1k4asZgYos2Dm7CU75zkY4QqQSMkt8GGRar",
        "MINING_VAULT_PUBLIC_KEY": "6i6EuPmUrg8R6zehqQKFd2XoE5A3mYjZQhm9u6ocBo7d",
        "MINING_CLAIM_PER_CLAIM": "250000000",
        "MINING_CLAIM_PER_DAY": "1000000000",
        "MINING_VAULT_SWEEP_LIMIT": "50",
        // Staging is also a deployed devnet environment and provides DIGGO_RPC_URL as a secret.
        "DIGGO_RPC_URLS": "https://api.devnet.solana.com https://solana-devnet.gateway.tatum.io",
        "POSTHOG_API_KEY": "phc_rUmzX7ft4ue8iLqACMEe8NgaJphvWYVD9WtwRGfC6nQK",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "SUPABASE_URL": "https://mtkvvcybpasehmscueox.supabase.co",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "DIGGO_PROGRAM_ID": "H3Y8GgTnvwv5U1bajfzj386YSPC48vvwjFroXYyHZFj5",
        "DIGGO_TREASURY": "6HHEkX5MxsoQwyCJZHvLnewmnsaw19vGT9Y8jhqH7GuJ",
        "VANITY_SUFFIX": "diggo",
        "CRANK_ENABLED": "0",
        "INDEXER_SIGNATURE_LIMIT": "500",
        "INDEXER_MAX_PAGES": "3",
        "INDEXER_COIN_LIMIT": "1000",
        // Same oracle and RNG knobs as production, listed for discoverability. Staging keeps the
        // day-long epoch so its commitment schedule matches production; only the API keys differ,
        // and those are per-environment secrets.
        //JUPITER_PRICE_URL: "",
        //JUPITER_PRICE_V2_URL: "",
        //PYTH_HERMES_URL: "",
        //PYTH_SOL_USD_FEED_ID: "",
        //ORACLE_MIN_EXTERNAL_SOURCES: "0",
        //ORACLE_SOL_USD_OVERRIDE: ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "diggo-db-staging",
          // TODO(staging): replace with the id from `wrangler d1 create diggo-db-staging`.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "./migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TOKEN_CACHE",
          // TODO(staging): replace with the id from `wrangler kv namespace create TOKEN_CACHE --env staging`.
          "id": "00000000000000000000000000000000"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MARKETS",
            "class_name": "TokenMarket"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["TokenMarket"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["PlayerLock"]
        },
        {
          "tag": "v3",
          "deleted_classes": ["PlayerLock"]
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INDEXING_QUEUE",
            // TODO(staging): `wrangler queues create diggo-indexing-staging` (and the -dlq queue).
            "queue": "diggo-indexing-staging"
          }
        ],
        "consumers": [
          {
            "queue": "diggo-indexing-staging",
            "max_batch_size": 20,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "diggo-indexing-staging-dlq"
          }
        ]
      },
      "triggers": {
        // Staging runs the same cadence so cron paths are exercised before production.
        "crons": ["*/5 * * * *"]
      },
      // Same account-level Analytics Engine restriction as production; see the comment above
      // the production block. Staging metrics stay in the staging D1 database.
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          // Distinct namespace id so staging traffic can never consume production budget.
          "namespace_id": "2001",
          "simple": {
            "limit": 500,
            "period": 60
          }
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
